            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All Apps": {
      "comment": "The title of the section in the All Apps side panel.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有应用"
          }
        }
      }
    },
    "All calendars are shown when none are selected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何日历时，显示所有日历。"
          }
        }
      }
    },
    "All conditions": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las condiciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "满足所有条件"
          }
        }
      }
    },
    "All Spaces": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los Spaces"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有桌面空间"
          }
        }
      }
    },
    "Allow Docky to control %1$@ in Privacy & Security > Automation, then try %2$@ again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Docky controle %1$@ en Privacidad y Seguridad > Automatización y vuelve a intentar %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统偏好设置 → 安全性与隐私 → 隐私 → 自动化”中允许 Docky 控制 %1$@，然后重试“%2$@”。"
          }
        }
      }
    },
    "Allow Docky to control System Events and %1$@ in Privacy & Security > Automation, then try %2$@ again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Docky controle System Events y %1$@ en Privacidad y Seguridad > Automatización y vuelve a intentar %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统偏好设置 → 安全性与隐私 → 隐私 → 自动化”中允许 Docky 控制 System Events 和 %1$@，然后重试“%2$@”。"
          }
        }
      }
    },
    "Allows tiles to use the enlarged dock sizing behavior when enabled.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los íconos usen el comportamiento de tamaño ampliado del dock cuando está activado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，允许项目随程序坞的放大效果增大。"
          }
        }
      }
    },
    "ALPHA": {
      "comment": "The text that appears as a badge indicating an alpha feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内测"
          }
        }
      }
    },
    "Alpha feature": {
      "comment": "An accessibility label for the alpha badge in the appearance settings view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试功能"
          }
        }
      }
    },
    "Alphabetical": {
      "comment": "Title for the Launchpad sort mode option that sorts items alphabetically.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按名称排序"
          }
        }
      }
    },
    "Always show a compact vertical list with app icons and window titles. No screen recording required.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar siempre una lista vertical compacta con íconos de apps y títulos de ventana. No requiere grabación de pantalla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示包含应用图标和窗口标题的紧凑竖向列表，无需屏幕录制权限。"
          }
        }
      }
    },
    "Always show window thumbnails. Requires screen recording permission to render preview images.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar siempre miniaturas de ventana. Requiere permiso de grabación de pantalla para renderizar las imágenes de vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示窗口缩略图，需要屏幕录制权限才能生成预览。"
          }
        }
      }
    },
    "An existing copy of Docky is already in Applications. Replacing it will keep the newer copy you just opened.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una copia de Docky en Aplicaciones. Reemplazarla mantendrá la copia más nueva que acabas de abrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“应用程序”文件夹中已有 Docky。替换后会保留你刚打开的这个较新版本。"
          }
        }
      }
    },
    "Any condition": {
      "extractionState": "stale",
