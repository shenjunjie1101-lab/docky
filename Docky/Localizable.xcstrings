        }
      }
    },
    "System Events automation wasn’t allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获准自动控制 System Events"
          }
        }
      }
    },
    "Allow Docky to control System Events in Privacy & Security > Automation, or use the Automation (System Events) row in Docky Settings to request access again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统偏好设置 → 安全性与隐私 → 隐私 → 自动化”中允许 Docky 控制 System Events，或在 Docky 设置的“自动化（System Events）”一行重新请求权限。"
          }
        }
      }
    },
    "Request System Events Access": {
      "localizations": {
        "zh-Hans": {
