    "Animation Duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画时长"
          }
        }
      }
    },
    "How long the slide takes when Docky shows or hides its window. Set to 0 to snap instantly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 Docky 窗口显示或隐藏时的滑动时长。设为 0 则立即切换，不播放动画。"
          }
        }
      }
    },
    "Dim Idle App Icons": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "淡化闲置应用图标"
          }
        }
      }
    },
    "Fades an app's tile to half opacity while the app is hidden or has no windows open. Turn off to keep icons fully opaque regardless of state. Detecting open windows needs Accessibility permission.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已隐藏或没有打开的窗口时，将其图标不透明度降为一半。关闭后始终完全显示。检测打开的窗口需要辅助功能权限。"
          }
        }
      }
    },
    "Icon Size in Opened Folders": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开文件夹中的图标大小"
          }
        }
      }
    },
    "Size of the app icons in an opened app folder. The folder window grows and shrinks with it. Default is 96 pt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置展开的应用文件夹中的图标大小，文件夹窗口也会随之调整。默认值为 96 磅。"
          }
        }
      }
    },
