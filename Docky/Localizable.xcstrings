    "Time the cursor must rest on a widget before its expanded preview window appears. Set to zero for an immediate preview.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo que el cursor debe permanecer sobre un widget antes de que aparezca la ventana de vista previa expandida. Pon cero para una vista previa inmediata."
          }
