        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前程序坞中的文件夹项目选择自定义图片，默认使用各文件夹的系统图标。"
          }
        }
      }
    },
    "Pick custom images for the Trash tile's empty and full states. Both default to the system Trash icons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige imágenes personalizadas para los estados vacío y lleno del ícono de Papelera. Ambos usan los íconos de Papelera del sistema por defecto."
          }
