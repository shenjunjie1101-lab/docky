{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "(minimized)": {
      "comment": "Appends \"(minimized)\" to the window title if the window is currently minimized.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（已最小化）"
          }
        }
      }
    },
    "%@ • %@": {
      "comment": "A subheading that includes the author's name and the version of the widget. The first argument is the author's name. The second argument is the version of the widget.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ • %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ • %@"
          }
        }
      }
    },
    "%@ s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒"
          }
        }
      }
    },
    "%@ will be removed from disk. It will keep running until you restart Docky.": {
      "comment": "A message in an alert that appears when a user attempts to install a `.dockywidget` bundle but the bundle is invalid or malformed.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从磁盘中移除 %@。它会继续运行，直到你重新启动 Docky。"
          }
        }
      }
    },
    "%lld": {
      "comment": "A stepper that lets the user adjust the number of columns in the Launchpad grid. The value shown is the current number of columns, and the stepper ranges from 1 to 12.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "A text label displaying the current value of a slider. The text inside the label is generated by interpolating the slider's value.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 磅"
          }
        }
      }
    },
    "%lld variants": {
      "comment": "A text label showing the number of variants available for a given item in the gallery. The argument is the number of variants for the item.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 种样式"
          }
        }
      }
    },
    "%lld%%": {
      "comment": "A text label showing the current padding",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "%lld°": {
      "comment": "A temperature value displayed in the weather widget forecast. The argument is the temperature in degrees Celsius, rounded to the nearest whole number.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld°"
          }
        }
      }
    },
    "Scales the text inside built-in widgets relative to their default sizes. Icons and layout stay the same. Third-party widgets draw their own text and aren't affected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala el texto de los widgets integrados en relación con su tamaño predeterminado. Los íconos y el diseño no cambian. Los widgets de terceros dibujan su propio texto y no se ven afectados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按默认字号的比例调整内置小组件的文字大小，图标和布局保持不变。第三方小组件自行绘制文字，不受此设置影响。"
          }
        }
      }
    },
    "Scroll over the stack to flip through every widget.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate sobre la pila para pasar por todos los widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在叠放项目上滚动，即可切换其中的小组件。"
          }
        }
      }
    },
    "Text Size": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del texto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小"
