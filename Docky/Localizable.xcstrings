            "value": "切换窗口"
          }
        }
      }
    },
    "Full Disk Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全磁盘访问权限"
          }
        }
      }
    },
    "Automation (Finder)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化（访达）"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Automation (System Events)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化（System Events）"
          }
        }
      }
    },
    "Screen Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制"
          }
        }
      }
    },
    "Grant Full Disk Access so Docky can preview recent items from folders pinned to the Dock, including protected locations like Downloads, Documents, and Desktop. No data leaves your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予完全磁盘访问权限，以便 Docky 预览固定文件夹中的最近项目，包括“下载”“文稿”和“桌面”等受保护位置。相关文件不会上传。"
          }
        }
      }
    },
    "Docky uses Finder automation for reveal-in-Finder, open-folder, and Trash actions. macOS grants this separately from Full Disk Access, and you can request it here without waiting for the first Finder action to fail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 通过访达自动化执行“在访达中显示”、打开文件夹和废纸篓操作。此权限与完全磁盘访问权限分开授予，可以直接在这里请求，无需等首次操作失败后再授权。"
          }
        }
      }
    },
    "Accessibility access lets Docky click menu bar items for curated menuClick actions, inspect app windows for Dock-like reopen behavior and window menus, and restore minimized windows beside the Trash. These actions are slower and more fragile than built-in actions, so Docky requests this only when needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限用于执行预设菜单点击操作、读取应用窗口、显示窗口菜单，以及恢复最小化窗口。这些操作比内置命令更慢，也更容易受系统或应用变化影响，因此仅在需要时请求权限。"
          }
        }
      }
    },
    "Docky uses System Events automation for curated menuClick actions. Requesting it here lets Docky click supported app menus without waiting for the first action to trigger a macOS prompt. Menu-click actions still require Accessibility too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 通过 System Events 自动化执行预设菜单点击操作。可以在这里提前授权，无需等首次操作触发系统提示。菜单点击操作还需要辅助功能权限。"
          }
        }
      }
    },
    "Grant Screen Recording so Docky can show thumbnail previews for minimized windows. Docky only captures the minimized window itself for its dock tile, and nothing leaves your Mac. macOS may require quitting and reopening Docky after you allow this.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予屏幕录制权限，以便 Docky 显示最小化窗口的缩略图。预览在本机生成，不会上传。授权后，macOS 可能要求退出并重新打开 Docky。"
          }
        }
      }
    },
    "Grant location access so Docky can show local weather in the Weather widget. Your location is used on-device to fetch the forecast and is not stored by Docky.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予定位权限，以便天气小组件显示本地天气。位置信息仅用于查询天气，Docky 不会保存你的位置。"
          }
        }
      }
    },
    "Grant Calendar access so the Calendar widget can show your upcoming events. Events are read on-device and never leave your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予日历权限，以便日历小组件显示即将开始的日程。日程仅在本机读取，不会上传。"
          }
        }
      }
    },
    "Grant Reminders access so the Reminders widget can show your open tasks. Reminders are read on-device and never leave your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予提醒事项权限，以便小组件显示未完成任务。提醒事项仅在本机读取，不会上传。"
          }
        }
      }
    },
    " is required": {
      "localizations": {
