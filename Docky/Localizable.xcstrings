        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky Pro 功能"
          }
        }
      }
    },
    "Docky Pro unlocks switcher preview modes and window context menus inside the switcher.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky Pro desbloquea los modos de vista previa del conmutador y los menús contextuales de ventana dentro del conmutador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky Pro 可解锁切换器预览模式和切换器内的窗口右键菜单。"
          }
        }
      }
    },
    "Docky Settings": {
      "comment": "A menu item that, when tapped, shows the Docky settings window.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 设置"
          }
        }
