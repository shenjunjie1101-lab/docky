    "Trash (%@)": {
      "comment": "A label describing the Trash icon. The argument is the title of the Trash icon.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓（%@）"
          }
        }
      }
    },
    "Treats the dock as a shelf of pinned apps and widgets. Use the toggles to pick which fixtures, Finder, Trash, or both, disappear while shelve mode is on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将程序坞作为只放置固定应用和小组件的简洁区域。可分别选择在此模式下隐藏访达、废纸篓，或同时隐藏两者。"
          }
        }
      }
    },
    "Troubleshoot": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solucionar problemas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故障排查"
          }
        }
      }
    },
    "Try a different search term to bring sections back into view.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro término de búsqueda para volver a mostrar las secciones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试其他搜索词，以重新显示相关设置。"
          }
        }
      }
    },
    "Try again": {
      "comment": "A button label that says \"Try again\" when a user fails to load the marketplace.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Turn Docky's Cmd-Tab-style switcher on or off without clearing its shortcut or preview preference.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el conmutador estilo Cmd-Tab de Docky sin borrar su atajo ni la preferencia de vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用或关闭 Docky 的窗口切换器，不会清除快捷键或预览偏好。"
          }
        }
      }
    },
    "Turn Docky's Launchpad overlay on or off without removing its shortcut or layout preferences.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la superposición de Launchpad de Docky sin eliminar su atajo ni las preferencias de diseño."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用或关闭 Docky 启动台，不会清除快捷键或布局偏好。"
          }
        }
      }
    },
    "Turn off to render the chosen image crisp. Default is on to soften the desktop wallpaper into a neutral backdrop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，所选图片保持清晰。默认开启，将桌面墙纸柔化为中性背景。"
          }
        }
      }
    },
