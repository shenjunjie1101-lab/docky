          }
        }
      }
    },
    "Controls how visible dividers are. 100% is fully opaque; 0% hides them entirely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔线的可见程度。100% 为完全不透明，0% 为完全隐藏。"
          }
