      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向内偏移"
          }
        }
      }
    },
    "Shifts the indicator further from or closer to the screen edge.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整运行标记与屏幕边缘之间的距离。"
          }
        }
      }
    },
    "Scales the indicator's rendered size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整运行标记的显示大小。"
          }
        }
      }
    },
    "Left Side": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧"
          }
        }
      }
    },
    "Controls how much each divider is inset along its short axis, as a fraction of the tile size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按图块大小的比例，设置分隔线在较短方向上的内缩量。"
          }
        }
      }
    },
    "Vertical Offset": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垂直偏移"
          }
        }
      }
    },
    "Shifts dividers along the tile's short axis. Positive values move them up in horizontal docks or right in vertical docks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿图块较短的方向移动分隔线。正值会使横向程序坞的分隔线上移，使纵向程序坞的分隔线右移。"
          }
        }
      }
    },
    "Image Size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片大小"
          }
        }
      }
    },
    "Scales custom divider images. Has no effect on the default line.": {
