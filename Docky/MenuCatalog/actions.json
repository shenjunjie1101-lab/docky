        {
          "id": "xcode.run",
          "title": "运行",
          "kind": "menuClick",
          "tileTypes": [
            "app"
          ],
          "targetApp": "com.apple.dt.Xcode",
          "permissions": [
            "accessibility"
          ],
          "inputs": [],
          "path": [
