{
  "version": 1,
  "packages": [
    {
      "id": "docky.core",
      "title": "Docky 核心操作",
      "author": "Docky",
      "version": "1.0.0",
      "reviewStatus": "curated",
      "description": "Docky 内置操作和经过审核的脚本扩展。",
      "actions": [
        {
          "id": "app.open",
          "title": "打开",
          "kind": "builtin",
          "builtinIdentifier": "openApp",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "not": {
              "flag": "isRunning"
            }
          }
        },
        {
          "id": "app.show-all-windows",
          "title": "显示所有窗口",
          "kind": "builtin",
          "builtinIdentifier": "showAllWindows",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "flag": "isRunning"
          }
        },
        {
          "id": "app.toggle-pin",
          "title": "保留在程序坞中",
          "kind": "builtin",
          "builtinIdentifier": "togglePinnedApp",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "toggleFlag": "isPinned",
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "flag": "canTogglePin"
          }
        },
        {
          "id": "app.show-in-finder",
          "title": "在访达中显示",
          "kind": "builtin",
          "builtinIdentifier": "showAppInFinder",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "requiresFrontmost": false,
          "holdOption": false
        },
        {
          "id": "app.hide",
          "title": "隐藏",
          "kind": "builtin",
          "builtinIdentifier": "hideApp",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "all": [
              {
                "flag": "isRunning"
              },
              {
                "not": {
                  "flag": "isFinder"
                }
              }
            ]
          }
        },
        {
          "id": "app.hide-others",
          "title": "隐藏其他应用",
          "kind": "applescript",
          "tileTypes": [
            "app"
          ],
          "targetApp": "com.apple.systemevents",
          "permissions": [
            "accessibility"
          ],
          "inputs": [
            "bundleIdentifier"
          ],
          "script": "tell application id \"com.apple.systemevents\"\n    set visible of every application process whose bundle identifier is not \"{{bundleIdentifier}}\" to false\nend tell",
          "destructive": false,
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "all": [
              {
                "flag": "isRunning"
              },
              {
                "not": {
                  "flag": "isFinder"
                }
              }
            ]
          }
        },
        {
          "id": "app.quit",
          "title": "退出",
          "alternateTitle": "Force Quit",
          "alternateTitleWhen": {
            "flag": "optionKey"
          },
          "kind": "builtin",
          "builtinIdentifier": "quitApp",
          "tileTypes": [
            "app"
          ],
          "permissions": [],
          "inputs": [],
          "destructive": false,
          "destructiveWhen": {
            "flag": "optionKey"
          },
          "requiresFrontmost": false,
          "holdOption": false,
          "when": {
            "all": [
              {
                "flag": "isRunning"
              },
              {
                "not": {
                  "flag": "isFinder"
                }
              }
            ]
          }
        },
