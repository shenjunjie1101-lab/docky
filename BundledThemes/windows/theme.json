{
  "schemaVersion": 1,
  "id": "windows",
  "name": "Windows 风格",
  "author": "Docky",
  "version": "1.0.0",
  "description": "简洁的 Windows 10 深色任务栏风格：直角面板、近乎不透明的炭灰色背景、紧凑间距，以及位于底部边缘的蓝色细条运行标记。",
  "behavior": {
    "windowAxisSizing": "fullAxis",
    "tileSize": 44,
    "showsActivePinnedSeparator": false
  },
  "layout": {
    "insertions": [
      {
        "kind": "search",
        "span": 4,
        "after": "pinned:com.apple.finder"
      },
      {
        "kind": "flexibleSpacer",
        "after": "divider:trailing"
      }
    ]
  },
  "appearance": {
    "disablesGlassLook": true,
    "iconShadow": {
      "color": {
        "r": 0,
        "g": 0,
        "b": 0
      },
      "radius": 0,
      "opacity": 0
    },
    "indicators": {
      "shape": "underline",
      "color": {
        "name": "accent"
      },
      "scale": 0.7,
      "offset": -2,
      "divider": {
        "color": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "opacity": 0.15,
        "paddingFraction": 0.15,
        "imageScale": 1,
        "offset": 0
      }
    },
    "tile": {
      "clipShape": "rounded",
      "spacing": 4,
      "verticalPadding": 4,
      "iconPadding": 6,
      "hover": {
        "backgroundColor": {
          "name": "white"
        },
        "backgroundOpacity": 0.12
      },
      "active": {
        "backgroundColor": {
          "name": "white"
        },
        "backgroundOpacity": 0.06
      }
    },
    "widgets": {
      "twoX": {
        "contentPadding": 0,
        "cornerRadius": 0,
        "ignoresAddedPaddings": true
      },
      "threeX": {
        "contentPadding": 0,
        "cornerRadius": 0,
        "ignoresAddedPaddings": true
      },
      "fourX": {
        "contentPadding": 0,
        "cornerRadius": 0,
        "ignoresAddedPaddings": true
      }
    },
    "window": {
      "clipShape": "rounded",
      "cornerRadius": 0,
      "contentInsets": {
        "top": 0,
        "leading": 0,
        "bottom": 0,
        "trailing": 0
      },
      "cornerRadii": {
        "topLeading": 0,
        "topTrailing": 0,
        "bottomLeading": 0,
        "bottomTrailing": 0
      },
      "backgroundImageMode": "fill",
      "tintColor": {
        "r": 0.118,
        "g": 0.118,
        "b": 0.118
      },
      "tintOpacity": 0.92,
      "borderColor": {
        "r": 1,
        "g": 1,
        "b": 1
      },
      "borderWidth": 0
    }
  }
}
